{
  "name": "xybernetex-openclaw",
  "version": "0.4.5",
  "description": "Xybernetex Supervisor for OpenClaw: holds destructive actions nobody asked for, checks the agent's work against acceptance checks (experimental), undoes fixes that break what worked, and stops runaway runs. Runs locally, MIT, no account needed.",
  "license": "MIT",
  "author": "Xybernetex Systems LLC <chris@xybernetex.com>",
  "homepage": "https://xybernetex.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xybernetex/xybernetex-openclaw.git"
  },
  "bugs": {
    "url": "https://github.com/xybernetex/xybernetex-openclaw/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "ai-agents",
    "agent-safety",
    "prompt-injection",
    "control-plane",
    "xybernetex"
  ],
  "type": "module",
  "bin": {
    "xybernetex-openclaw": "scripts/cli.mjs"
  },
  "files": [
    "index.ts",
    "dist/",
    "openclaw.plugin.json",
    "assets/icon.png",
    "src/",
    "scripts/cli.mjs",
    "scripts/prompt.mjs",
    "scripts/setup.mjs",
    "scripts/report.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "report": "node scripts/report.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.22"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.3.22",
      "minGatewayVersion": "2026.3.22"
    },
    "build": {
      "openclawVersion": "2026.9.6"
    }
  }
}
