{
  "name": "xybernetex-openclaw",
  "version": "0.4.0",
  "description": "Xybernetex control plane for OpenClaw: authorization-aware safety gate, retry and check-your-work follow-ups, outcome measurement and customer report.",
  "license": "MIT",
  "author": "Xybernetex Systems LLC <chris@xybernetex.com>",
  "homepage": "https://xybernetex.com",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "ai-agents",
    "agent-safety",
    "prompt-injection",
    "control-plane",
    "xybernetex"
  ],
  "type": "module",
  "bin": {
    "xybernetex-openclaw": "scripts/cli.mjs"
  },
  "files": [
    "index.ts",
    "dist/",
    "openclaw.plugin.json",
    "src/",
    "scripts/cli.mjs",
    "scripts/prompt.mjs",
    "scripts/setup.mjs",
    "scripts/report.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "report": "node scripts/report.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.22"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.3.22",
      "minGatewayVersion": "2026.3.22"
    }
  }
}
